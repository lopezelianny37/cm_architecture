NODE_ENV=development

# Database
DATABASE_URL=postgresql://gemba_user:gemba_password@postgres:5432/gemba_db

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-anon-key
SUPABASE_JWT_SECRET=your-jwt-secret
# Service role key: bypasses RLS entirely. Used ONLY by server-side-only
# flows with no auth.uid() (e.g. the public moving-motivators endpoint).
# Never expose this to the frontend.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# JWT
JWT_SECRET=your-jwt-secret-change-in-production

# Server
PORT=3000
