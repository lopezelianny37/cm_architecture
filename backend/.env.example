NODE_ENV=development

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-anon-key
# Service role key: bypasses RLS entirely. Used ONLY by server-side-only
# flows with no auth.uid() (e.g. the public moving-motivators endpoint).
# Never expose this to the frontend.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# CORS allowlist for the deployed frontend's origin — only read when
# NODE_ENV=production (see main.ts). Not needed for local dev.
FRONTEND_URL=https://your-deployed-frontend.example.com

# Server
PORT=3000
